POSTGRES_DB=flask_app
POSTGRES_USER=flask_user
POSTGRES_PASSWORD=flask_password
POSTGRES_PORT=5432
FLASK_PORT=5000
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin1234
TMDB_ACCESS_TOKEN=

# AI 개인화 추천 (비어 있으면 규칙 기반 추천으로 동작)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=20
RECOMMENDATION_TTL_HOURS=24
RECOMMENDATION_LIMIT=10
RECOMMENDATION_CANDIDATE_LIMIT=30

# Flask 세션 서명용 비밀키 (운영에서는 반드시 무작위 값으로 교체)
SECRET_KEY=dev-secret-change-me

# Google Cloud Console > APIs & Services > Credentials 에서 발급
# 리디렉션 URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
